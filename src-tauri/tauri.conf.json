{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Booming Desktop",
  "version": "0.1.0",
  "identifier": "app.boomingdesktop.desktop",
  "build": {
    "beforeDevCommand": "bun run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "bun run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Booming Desktop",
        "width": 1180,
        "height": 800,
        "minWidth": 640,
        "minHeight": 480,
        "resizable": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; connect-src 'self' ipc: http://ipc.localhost https://lrclib.net"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["deb", "appimage"],
    "category": "Audio",
    "shortDescription": "Offline music player",
    "icon": ["icons/32x32.png", "icons/icon.png"],
    "resources": [
      "resources/",
      "resources/mpv/libmpv.so.2",
      "resources/mpv/libmpv-2.dll",
      "resources/mpv/libmpv.dylib"
    ]
  }
}
